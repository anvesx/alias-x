{
  "name": "alias-x",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:runtime": "node test/runtime-journey.mjs",
    "check": "npm run typecheck && npm test",
    "db:local": "wrangler d1 migrations apply alias-db --local",
    "deploy": "wrangler deploy",
    "proxy:local": "node scripts/slack-tunnel-proxy.mjs",
    "recover:local": "node scripts/local-recovery.mjs",
    "recover:watch": "node scripts/local-recovery.mjs --watch"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "wrangler": "4.147.0",
    "typescript": "7.0.2",
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest"
  }
}
