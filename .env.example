# Copy to .env on the server (mode 600) and fill in. Never commit the real file.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
# Comma-separated channel IDs, or * for every channel in the workspace
ALLOWED_CHANNEL_IDS=
# Where the SQLite file lives (the folder is created if missing)
DB_PATH=/var/lib/alias-x/alias-x.db
PORT=8787
# Keep 127.0.0.1: Caddy on the same machine forwards HTTPS traffic to it
HOST=127.0.0.1
